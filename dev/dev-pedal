#!/usr/bin/env bash
# dev/dev-pedal — the pedal's back end, locally, for rigpa on the Mac (docs/plan.md, "Dev loop").
#
#   dev/dev-pedal            run namchaind and pedald under .dev/ until Ctrl-C
#
# namchaind is ../namchain/build-mac/namchaind (build it there first), on the null backend: no
# audio device, a paced clock. pedald is ../pedal.project's, run from its source tree. Both read one
# .dev/namchaind.json, as on the pedal, and rigpa reads it too through .dev/rigpa.json:
#
#   mise run run -- --config .dev/rigpa.json
#
# The library is ~/Documents/Audio's NAM/ and IRs/ (what sync-library sends to the pedal, so the
# ids match vip's), or RIGPA_DEV_LIBRARY's; it is only ever read. Without one, namchain's
# generated test models stand in, and the fixture rigs' models show as missing. The fixture rigs
# in dev/rigs/ are copied into .dev/library/rigs/ once; after that the copies are the dev pedal's
# own (delete them to start again).
#
# RIGPA_DEV_DIR (default .dev), RIGPA_DEV_ENGINE_PORT and RIGPA_DEV_PEDALD_PORT run a second,
# separate back end beside the first, for tests and tools.
#
# The null backend has no input, so the meters stay flat. RIGPA_DEV_INPUT=<a 48 kHz WAV> switches
# to the coreaudio backend, which loops that file as the input and plays the rig through the
# Mac's default output: the meters move, and you hear it.
#
# RIGPA_DEV_PROFILE=blackhole switches to the coreaudio backend with a *live* input instead: macOS's
# BlackHole loopback device (RIGPA_DEV_INPUT_DEVICE, default BlackHole2ch_UID), so anything played
# into BlackHole — the system output, a player, another app — comes out of the rig. It is
# `mise run blackhole`, and it uses its own pair of configs, .dev/namchaind-blackhole.json and
# .dev/rigpa-blackhole.json. They are written once from the same skeleton as the default pair and
# then left alone, so an edited device UID (or an added output `device`) survives a restart; delete
# them to regenerate. RIGPA_DEV_INPUT_DEVICE seeds the first version of that file and is ignored
# after it exists. The two profiles share one dev dir, token, library and set of ports, so run one
# at a time.
set -euo pipefail

ROOT=$(cd "$(dirname "$0")/.." && pwd)
DEV=${RIGPA_DEV_DIR:-$ROOT/.dev}
NAMCHAIN=${NAMCHAIN:-$ROOT/../namchain}
NAMCHAIND=$NAMCHAIN/build-mac/namchaind
PEDAL_ROOTFS=${PEDAL_ROOTFS:-$ROOT/../pedal.project/devices/common/rootfs}
PEDALD_LIB=$PEDAL_ROOTFS/usr/local/lib
ENGINE_PORT=${RIGPA_DEV_ENGINE_PORT:-47810}
PEDALD_PORT=${RIGPA_DEV_PEDALD_PORT:-47820}

die() { printf 'dev-pedal: %s\n' "$*" >&2; exit 1; }
[[ -x $NAMCHAIND ]] || die "no $NAMCHAIND: build it with 'cmake --build build-mac --target namchaind' in $NAMCHAIN"
[[ -d $PEDALD_LIB/pedald ]] || die "no pedald in $PEDALD_LIB"

# Which pair of configs this run uses. The default pair is generated every run, because
# RIGPA_DEV_INPUT changes what it says; a profile's pair is only written when it is missing, because
# the point of a profile is that its device settings can be edited.
PROFILE=${RIGPA_DEV_PROFILE:-}
case $PROFILE in
  "" | blackhole) ;;
  *) die "unknown RIGPA_DEV_PROFILE '$PROFILE' (leave it empty, or use blackhole)" ;;
esac
[[ -z $PROFILE || -z ${RIGPA_DEV_INPUT:-} ]] || die "RIGPA_DEV_INPUT (a WAV) and RIGPA_DEV_PROFILE=$PROFILE both choose the capture: use one"
SUFFIX=
if [[ $PROFILE == blackhole ]]; then SUFFIX=-blackhole; fi
NAMCHAIND_CONFIG=$DEV/namchaind$SUFFIX.json
RIGPA_CONFIG=$DEV/rigpa$SUFFIX.json
NAMCHAIND_LOG=$DEV/logs/namchaind$SUFFIX.log
PEDALD_LOG=$DEV/logs/pedald$SUFFIX.log

# A profile's config is authoritative, and this script will not rewrite it: if it already exists and
# names another tcp_port (an earlier run under other env overrides), that is the port to check and
# to report, not the one this run would have generated. pedald's own config is written every run,
# and pedald finds the engine through this file, so the two still agree.
if [[ -n $PROFILE && -e $NAMCHAIND_CONFIG ]]; then
  CONFIG_PORT=$(sed -n 's/.*"tcp_port"[[:space:]]*:[[:space:]]*\([0-9][0-9]*\).*/\1/p' "$NAMCHAIND_CONFIG" | head -1)
  if [[ -n $CONFIG_PORT && $CONFIG_PORT != "$ENGINE_PORT" ]]; then
    printf 'dev-pedal: %s names tcp_port %s; using it (delete the file to regenerate at %s).\n' \
      "$NAMCHAIND_CONFIG" "$CONFIG_PORT" "$ENGINE_PORT" >&2
    ENGINE_PORT=$CONFIG_PORT
  fi
fi

for port in "$ENGINE_PORT" "$PEDALD_PORT"; do
  if nc -z 127.0.0.1 "$port" 2>/dev/null; then
    die "something already listens on 127.0.0.1:$port (another dev-pedal?): $(lsof -nP -iTCP:"$port" -sTCP:LISTEN 2>/dev/null | awk 'NR==2 {print $1, "pid", $2}')"
  fi
done

mkdir -p "$DEV/logs" "$DEV/state" "$DEV/library/rigs"

LIBRARY=${RIGPA_DEV_LIBRARY:-$HOME/Documents/Audio}
if [[ -d $LIBRARY/NAM && -d $LIBRARY/IRs ]]; then
  MODELS=$LIBRARY/NAM
  IRS=$LIBRARY/IRs
else
  MODELS=$DEV/library/models
  IRS=$DEV/library/irs
  GENERATED=$NAMCHAIN/build-mac/generated
  [[ -f $GENERATED/A2-Lite.nam ]] || die "no test models in $GENERATED: run namchain's tests once to generate them"
  mkdir -p "$MODELS" "$IRS"
  cp -n "$GENERATED/A2-Lite.nam" "$GENERATED/A2-Full.nam" "$MODELS/" 2>/dev/null || true
  cp -n "$GENERATED/CabIR.nam" "$IRS/" 2>/dev/null || true
fi

for rig in "$ROOT"/dev/rigs/*.json; do
  [[ -e $DEV/library/rigs/$(basename "$rig") ]] || cp "$rig" "$DEV/library/rigs/"
done
# As on the pedal, the engine starts on last.json, the resume snapshot pedald keeps.
[[ -e $DEV/library/rigs/last.json ]] || cp "$ROOT/dev/rigs/Clean.json" "$DEV/library/rigs/last.json"

if [[ ! -s $DEV/token ]]; then
  (umask 077; od -An -tx1 -N32 /dev/urandom | tr -d ' \n' > "$DEV/token")
fi

if [[ $PROFILE == blackhole ]]; then
  # A live input, so there is no --capture-path here: the coreaudio backend refuses both.
  # coreaudio's period is a ceiling — the device's own callback is measured and used — but it must
  # be at least that callback, and a Mac's output device delivers 512-frame ones, which a plan
  # built for 64 refuses with "restart with --period-size 512".
  BACKEND='"backend": "coreaudio", "input_device": "'"${RIGPA_DEV_INPUT_DEVICE:-BlackHole2ch_UID}"'", "period_size": 1024,'
elif [[ -n ${RIGPA_DEV_INPUT:-} ]]; then
  [[ -f $RIGPA_DEV_INPUT ]] || die "no such WAV: $RIGPA_DEV_INPUT"
  # coreaudio's period is a ceiling: the device's own period is measured and used.
  BACKEND='"backend": "coreaudio", "capture_path": "'"$RIGPA_DEV_INPUT"'", "period_size": 1024,'
else
  BACKEND='"backend": "null", "period_size": 64,'
fi

if [[ -z $PROFILE || ! -e $NAMCHAIND_CONFIG ]]; then
cat > "$NAMCHAIND_CONFIG" <<JSON
{
  $BACKEND
  "sample_rate": 48000,
  "capture_channels": 2,
  "playback_channels": 2,
  "rig": "last.json",
  "rigs_root": "$DEV/library/rigs",
  "models_root": "$MODELS",
  "irs_root": "$IRS",
  "socket": "namchaind.sock",
  "lock_memory": false,
  "rt_priority": 0,
  "tcp_listen": true,
  "tcp_address": "127.0.0.1",
  "tcp_port": $ENGINE_PORT,
  "tcp_token_file": "$DEV/token"
}
JSON
fi
cat > "$DEV/pedald.json" <<JSON
{
  "uart_device": "$DEV/no-pico",
  "http_host": "127.0.0.1",
  "http_port": $PEDALD_PORT,
  "state_root": "$DEV/state"
}
JSON
[[ -e $RIGPA_CONFIG ]] || cat > "$RIGPA_CONFIG" <<JSON
{
  "engine_config": "$NAMCHAIND_CONFIG",
  "pedald_config": "$DEV/pedald.json",
  "settings_file": "$DEV/settings.ini"
}
JSON

pids=()
stop() { for pid in "${pids[@]}"; do kill "$pid" 2>/dev/null || true; done; wait 2>/dev/null || true; }
trap stop EXIT INT TERM

# The socket path is relative: macOS caps Unix socket paths at 104 bytes.
(cd "$DEV" && exec "$NAMCHAIND" --config "$NAMCHAIND_CONFIG") > "$NAMCHAIND_LOG" 2>&1 &
pids+=($!)
PEDALD_LIB=$PEDALD_LIB python3 "$PEDAL_ROOTFS/usr/local/sbin/pedald" run --config "$DEV/pedald.json" \
  --engine-config "$NAMCHAIND_CONFIG" > "$PEDALD_LOG" 2>&1 &
pids+=($!)

printf 'namchaind on 127.0.0.1:%s, pedald on 127.0.0.1:%s; logs in %s/logs. Ctrl-C stops both.\n' \
  "$ENGINE_PORT" "$PEDALD_PORT" "$DEV"
printf 'rigpa: mise run run -- --config %s\n' "$RIGPA_CONFIG"
if [[ -n $PROFILE ]]; then
  printf 'profile %s: %s is kept as it is (delete it to regenerate)\n' "$PROFILE" "$NAMCHAIND_CONFIG"
fi
wait -n "${pids[@]}" || true
die "a back-end process stopped; see $DEV/logs/"
